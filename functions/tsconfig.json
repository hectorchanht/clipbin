{
  // Pages Functions are bundled by wrangler/esbuild for the Workers runtime.
  // Keep a modern target here: the root tsconfig targets the CRA app and must
  // not force an es5 down-transform on the functions bundle (esbuild cannot
  // transform const/async/spread to es5 and fails the deploy).
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true
  },
  "include": ["."]
}
